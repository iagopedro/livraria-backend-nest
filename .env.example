# ──────────────────────────────────────────────────────────────
# VARIÁVEIS DE AMBIENTE — DESENVOLVIMENTO LOCAL
#
# Copie este arquivo para ".env" e preencha os valores.
# NUNCA commite o arquivo ".env" real no repositório (está no .gitignore).
# ──────────────────────────────────────────────────────────────

# Ambiente: development | production | test
NODE_ENV=development

# Porta do servidor HTTP (a Azure injeta PORT automaticamente em produção)
PORT=3000

# ── Banco de Dados ──────────────────────────────────────────────
# Em desenvolvimento (NODE_ENV=development), o banco é SQLite local.
# Apenas DB_PATH é usado neste caso.
DB_PATH=livraria-dev.db

# Em produção (Azure SQL), preencha as variáveis abaixo:
DB_HOST=seu-servidor.database.windows.net
DB_PORT=1433
DB_NAME=livraria
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha_segura
# true apenas em ambientes de homologação com certificado autoassinado
DB_TRUST_CERT=false

# ── CORS ────────────────────────────────────────────────────────
# Lista de origens permitidas separadas por vírgula.
# Ex. produção: https://sua-app.azurestaticapps.net
CORS_ORIGINS=http://localhost:4200
